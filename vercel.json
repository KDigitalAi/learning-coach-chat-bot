{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat_handler.py"
    },
    {
      "source": "/api/health",
      "destination": "/api/chat_handler.py"
    },
    {
      "source": "/api/onboarding/(.*)",
      "destination": "/api/chat_handler.py"
    },
    {
      "source": "/api/status",
      "destination": "/api/status.py"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ],
  "functions": {
    "api/*.py": {
      "memory": 1024,
      "maxDuration": 10,
      "includeFiles": "backend/**"
    }
  }
}