{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/onboarding/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/test",
      "destination": "/api/test.py"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ],
  "functions": {
    "api/*.py": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}