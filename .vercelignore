# Ignore unnecessary files for Vercel deployment to optimize bundle size

# Node.js
node_modules/
frontend/node_modules/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.eggs/

# Environment files
.env
.env.local
.env.*.local
*.env

# Database files
chroma_db/
*.sqlite3
*.db
*.sqlite

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Development files
start_server.bat
*.bat
*.sh

# Documentation (keep README.md)
*.md
!README.md

# Test files
tests/
test/
*_test.py
*_test_*.py
__tests__/

# Git
.git/
.gitignore

# Vercel
.vercel/

# Build artifacts (will be generated)
frontend/dist/
backend/__pycache__/

